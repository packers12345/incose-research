# Copy to .env and fill in.
#
# ANTHROPIC_API_KEY  principle generation and testing, and the n8n testbed runs
# OPENAI_API_KEY     the ICAIv2 clustering embeddings only (Anthropic has no
#                    embeddings endpoint). Not needed for a --dry-run.

ANTHROPIC_API_KEY=sk-ant-YOUR-KEY-HERE
OPENAI_API_KEY=sk-YOUR-KEY-HERE

# Optional: pin the model a research run uses.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: which ground truth to score against - auto | v5 | aseries | survey
# AI4RE_GT_SOURCE=auto
